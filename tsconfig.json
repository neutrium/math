{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmitOnError": true,
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/tests/**"
  ]
}
